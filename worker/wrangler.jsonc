{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "autumn-tracker-feishu-sync",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "secrets": {
    "required": ["FEISHU_APP_ID", "FEISHU_APP_SECRET", "SYNC_TOKEN"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://witchear.github.io,http://localhost:8000,http://127.0.0.1:8000"
  }
}
